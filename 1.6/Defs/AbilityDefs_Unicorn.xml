<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <AbilityDef>
    <defName>DZ_UnicornBlessing</defName>
    <label>unicorn blessing</label>
    <description>Touch an ally with a calming radiance that sharpens the mind and lifts the spirit for a couple of hours.</description>
    <iconPath>BSCE/Abilities/Unicorn</iconPath>
    <cooldownTicksRange>10000</cooldownTicksRange>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <statBases>
      <Ability_Duration>83</Ability_Duration>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>1</warmupTime>
      <range>2.9</range>
      <drawAimPie>true</drawAimPie>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetHumans>true</canTargetHumans>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>true</canTargetSelf>
        <neverTargetHostileFaction>true</neverTargetHostileFaction>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>DZ_UnicornBlessing</hediffDef>
        <replaceExisting>true</replaceExisting>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>DZ_UnicornMending</defName>
    <label>unicorn mending</label>
    <description>Touch an ally with restorative radiance. For six hours their wounds knit twice as fast and their body fights off disease at twice the rate.</description>
    <iconPath>BSCE/Abilities/UnicornMend</iconPath>
    <cooldownTicksRange>30000</cooldownTicksRange>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <statBases>
      <Ability_Duration>250</Ability_Duration>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>1</warmupTime>
      <range>2.9</range>
      <drawAimPie>true</drawAimPie>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetHumans>true</canTargetHumans>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>true</canTargetSelf>
        <neverTargetHostileFaction>true</neverTargetHostileFaction>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>DZ_UnicornMending</hediffDef>
        <replaceExisting>true</replaceExisting>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
    </comps>
  </AbilityDef>

</Defs>
