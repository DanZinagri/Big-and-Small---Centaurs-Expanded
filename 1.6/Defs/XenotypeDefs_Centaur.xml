<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <XenotypeDef>
    <defName>DZ_Centaur</defName>
    <label>centaur</label>
    <description>Half human, half horse. Centaurs carry a human torso atop an equine body, trading the reach of a two-legged frame for speed and the strength to haul a punishing load.</description>
    <iconPath>BSCE/Icons/Centaur</iconPath>
    <inheritable>true</inheritable>
    <displayPriority>300</displayPriority>
    <genes>
      <li>Aggression_Aggressive</li>
      <li>MeleeDamage_Strong</li>
      <li>Body_Standard</li>
      <li>Body_Hulk</li>
      <li>AptitudeStrong_Shooting</li>
      <li>AptitudeStrong_Melee</li>
      <li>AptitudeTerrible_Artistic</li>
      <li>AptitudeTerrible_Medicine</li>
      <li>DZ_CentaurEars</li>
      <li>DZ_CentaurBody</li>
      <li>DZ_CentaurNose</li>
      <li MayRequire="tug.minotaur">RBM_RuminantStomach</li>
      <li MayRequire="tug.minotaur">RBM_EstrousCycle</li>
      <li MayRequire="Euterpe.MilkyTitfuck">SEX_MoreMilk</li>
    </genes>
  </XenotypeDef>

  <XenotypeDef>
    <defName>DZ_Racing_Centaur</defName>
    <label>racing centaur</label>
    <description>A Racing Centaur, also known sometimes as Lightweight Centaur, are a smaller and faster varient of the centaur race.</description>
    <iconPath>BSCE/Icons/Centaur</iconPath>
    <inheritable>true</inheritable>
    <displayPriority>300</displayPriority>
    <genes>
      <li>MoveSpeed_Quick</li>
      <li>NakedSpeed</li>
      <li>Body_Standard</li>
      <li>Body_Thin</li>
      <li>AptitudeStrong_Melee</li>
      <li>AptitudeTerrible_Construction</li>
      <li>AptitudeTerrible_Cooking</li>
      <li>DZ_CentaurEars</li>
      <li>DZ_CentaurBody_Light</li>
      <li>DZ_CentaurNose</li>
      <li MayRequire="tug.minotaur">RBM_RuminantStomach</li>
      <li MayRequire="tug.minotaur">RBM_EstrousCycle</li>
    </genes>
  </XenotypeDef>

