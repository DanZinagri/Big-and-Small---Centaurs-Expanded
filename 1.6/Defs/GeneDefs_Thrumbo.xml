  <GeneDef ParentName="GeneHairColorBase">
    <defName>DZ_Hair_Thrumbo</defName>
    <label>thrumbo-white hair</label>
    <description>Carriers of this gene grow the pale blue-white pelt of a thrumbo.</description>
    <hairColorOverride>(233, 241, 255)</hairColorOverride>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <displayOrderInCategory>135</displayOrderInCategory>
  </GeneDef>

  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>DZ_Skin_Thrumbo</defName>
    <label>thrumbo-pale skin</label>
    <labelShortAdj>pale</labelShortAdj>
    <description>Carriers of this gene have the cold grey-white skin of thrumbo stock.</description>
    <skinColorOverride>(197, 204, 220)</skinColorOverride>
    <randomBrightnessFactor>0</randomBrightnessFactor>
