<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <GeneDef ParentName="BS_BodySwitchNonExclusive">
    <defName>DZ_CentaurBody_RoyalThrumbo</defName>
    <label>royal thrumboran body</label>
    <description>Carriers of this gene have the four-legged lower body of a royal thrumbo in place of regular human legs. Even heavier and more richly furred than common thrumbo stock.</description>
    <!-- Must sort BEFORE DZ_CentaurBody_Thrumbo (802). The morph adds this gene while the
         thrumbo body is still present, and GeneUtility.Overrides breaks the tie between two
         conflicting endogenes on GenesInOrder index, i.e. displayOrderInCategory, lowest wins.
         If this gene loses that tie it is inactive when B&S's Gene.PostAdd hook runs, so it
         never requests thingDefSwap BS_Centaur, while the outgoing gene, still active, releases
         it. The pawn then silently drops off the centaur race, losing its baseBodySize and the
         centauroid race hediff, and a reload does not repair it. -->
    <displayOrderInCategory>801.1</displayOrderInCategory>
    <statOffsets>
      <CarryingCapacity>50</CarryingCapacity>
      <SM_BodySizeOffset>0.5</SM_BodySizeOffset>
    </statOffsets>
    <statFactors>
      <MoveSpeed>1.0</MoveSpeed>
      <CarryingCapacity>1.5</CarryingCapacity>
      <SM_BodySizeMultiplier>1.75</SM_BodySizeMultiplier>
      <ConstructionSpeed>1.10</ConstructionSpeed>
    </statFactors>
    <biostatCpx>0</biostatCpx>
    <biostatMet>-3</biostatMet>
    <randomChosen>false</randomChosen>
    <geneClass>BigAndSmall.ProductionGene</geneClass>
    <iconPath>BSCE/Icons/RoyalThrumbo</iconPath>
    <exclusionTags>
      <li>Bug_BodyAttachment</li>
      <li>taur</li>
    </exclusionTags>
    <modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <thingDefSwap>BS_Centaur</thingDefSwap>
        <renderCacheOff>true</renderCacheOff>
        <bodyDrawData>
          <dataEast>
            <offset>(0.5, 0, 0)</offset>
          </dataEast>
          <dataNorth>
            <offset>(0, 0, 0.15)</offset>
          </dataNorth>
        </bodyDrawData>
      </li>
      <!-- The royal thrumbo is the only thrumbo that can be sheared. Its wool grows slowly but
           is worth 18/unit, so this mirrors the animal's own 60-day shear interval rather than
           the direhorse gene's 25. RoyalThrumbo_Wool only exists while Royal Thrumbos is
           loaded, which is exactly when this folder loads. -->
      <li Class="BigAndSmall.ProductionGeneSettings">
        <product>RoyalThrumbo_Wool</product>
        <frequencyInDays>60</frequencyInDays>
        <baseAmount>30</baseAmount>
        <progressName>Growing royal thrumbo wool</progressName>
        <saveKey>DZ_RoyalThrumboWoolProduction</saveKey>
      </li>
    </modExtensions>
    <renderNodeProperties>
      <!-- default body types -->
      <li Class="BigAndSmall.PawnRenderingProps_Ultimate">
        <nodeClass>BigAndSmall.PawnRenderNode_Ultimate</nodeClass>
        <workerClass>BigAndSmall.PawnRenderNodeWorker_LazyCentaur</workerClass>
        <parentTagDef>Body</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <conditionalGraphics>
          <texturePaths>
            <li>BSCE/RoyalThrumboBody/BS_RoyalThrumbo</li>
            <MaleBody_Fat>BS_Blank</MaleBody_Fat>
            <FemaleBody_Fat>BS_Blank</FemaleBody_Fat>
            <NoneBody_Fat>BS_Blank</NoneBody_Fat>
          </texturePaths>
          <colorA>
            <hairColor>true</hairColor>
            <brightness>0.95</brightness>
            <alts>
              <li>
                <triggers><li>Dead</li></triggers>
                <hairColor>true</hairColor>
                <skinColor>true</skinColor>
                <saturation>0.6</saturation>
              </li>
            </alts>
          </colorA>
          <colorB>
            <hairColor>true</hairColor>
          </colorB>
          <colorC>
            <hairColor>true</hairColor>
          </colorC>
        </conditionalGraphics>
        <drawSize>(1.3,1.3)</drawSize>
        <drawData>
          <bodyTypeScales>
            <Fat>1.35</Fat>
            <Hulk>1.1</Hulk>
            <Thin>0.85</Thin>
            <Child MayRequire="Ludeon.Rimworld.Biotech">0.85</Child>
            <Baby MayRequire="Ludeon.Rimworld.Biotech">0.70</Baby>
          </bodyTypeScales>
          <dataNorth>
            <offset>(0, 0.000, -0.48)</offset>
            <layer>89.5</layer>
          </dataNorth>
          <dataSouth>
            <offset>(0, -0.000, 0.08)</offset>
            <layer>89.5</layer>
          </dataSouth>
          <dataEast>
            <offset>(-0.44, 0.0, -0.2)</offset>
            <layer>89.5</layer>
          </dataEast>
          <dataWest>
            <offset>(0.44, 0.0, -0.2)</offset>
            <layer>89.5</layer>
