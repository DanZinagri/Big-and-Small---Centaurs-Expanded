  <!-- Gender-split horn. texturePaths is an AdaptivePathList, so the Male/Female keys pick the
       variant per pawn; the melee tool reuses the plain thrumbo horn hediff. -->
  <GeneDef ParentName="GeneHeadboneBase">
    <defName>DZ_RoyalThrumboHorn</defName>
    <label>royal thrumbo-horn</label>
    <description>Carriers of this gene grow the great branching horns of a royal thrumbo. Males carry the heavier rack.</description>
    <iconPath>UI/Icons/Genes/Gene_DZ_RoyalThrumboHorn</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <!-- Not randomChosen, despite GeneHeadboneBase. Random-chosen genes are skipped by
         Pawn_GeneTracker.CheckForOverrides, so when a morph swaps one horn for another the
         incoming gene can stay flagged as overridden by a gene that no longer exists, and only
         a reload clears it. Opting out puts these on the path that recomputes on every add and
         remove. Safe because biostatCpx/biostatMet are non-zero, so GeneDef.RandomChosen
         resolves to false, and because these horns are always granted explicitly. -->
    <randomChosen>false</randomChosen>
    <modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <applyPartHediff>
          <li>
            <hediff>DZ_ThrumboHorn</hediff>
            <bodyparts>
              <li>Head</li>
            </bodyparts>
          </li>
        </applyPartHediff>
      </li>
    </modExtensions>
    <renderNodeProperties>
      <li Class="BigAndSmall.PawnRenderingProps_Ultimate">
        <nodeClass>BigAndSmall.PawnRenderNode_UltimateHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <parentTagDef>Head</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <conditionalGraphics>
          <texturePaths>
            <Male>BSCE/RoyalThrumboHorn/Male/DZ_RoyalThrumboHornM</Male>
            <Female>BSCE/RoyalThrumboHorn/Female/DZ_RoyalThrumboHornF</Female>
            <None>BSCE/RoyalThrumboHorn/Male/DZ_RoyalThrumboHornM</None>
          </texturePaths>
          <colorA>
            <color>(255, 255, 255)</color>
          </colorA>
        </conditionalGraphics>
        <drawData>
          <defaultData>
            <layer>10</layer>
          </defaultData>
          <dataSouth>
            <layer>80</layer>
          </dataSouth>
          <dataNorth>
            <layer>80</layer>
          </dataNorth>
        </drawData>
      </li>
    </renderNodeProperties>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>royal</symbol></li>
        <li><symbol>crown</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>horn</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef ParentName="GeneHairColorBase">
    <defName>DZ_Hair_RoyalThrumbo</defName>
    <label>royal thrumbo-cream hair</label>
    <description>Carriers grow the heavy cream-white pelt of a royal thrumbo.</description>
    <hairColorOverride>(239, 225, 209)</hairColorOverride>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <displayOrderInCategory>136</displayOrderInCategory>
  </GeneDef>

</Defs>
