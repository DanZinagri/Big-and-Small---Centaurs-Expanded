<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/XenotypeDef[defName="DZ_DireCentaur"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs</xpath>
      <value>

        <AtavismLibraries.GeneticAtavismDef>
          <defName>DZ_Atavism_Centaur_To_Dire</defName>
          <sourceXenotype>DZ_Centaur</sourceXenotype>
          <targetXenotype>DZ_DireCentaur</targetXenotype>
          <chance>0.02</chance>
          <InheritanceMode>excess</InheritanceMode>
          <order>4</order>
        </AtavismLibraries.GeneticAtavismDef>

        <AtavismLibraries.GeneticAtavismDef>
          <defName>DZ_Atavism_Dire_To_Wooly</defName>
          <sourceXenotype>DZ_DireCentaur</sourceXenotype>
          <targetXenotype>DZ_WoolyCentaur</targetXenotype>
          <chance>0.15</chance>
          <InheritanceMode>excess</InheritanceMode>
          <order>0</order>
        </AtavismLibraries.GeneticAtavismDef>

        <AtavismLibraries.GeneticAtavismDef>
          <defName>DZ_Atavism_Dire_To_Centaur</defName>
          <sourceXenotype>DZ_DireCentaur</sourceXenotype>
          <targetXenotype>DZ_Centaur</targetXenotype>
          <chance>0.02</chance>
          <InheritanceMode>excess</InheritanceMode>
          <order>1</order>
        </AtavismLibraries.GeneticAtavismDef>

        <AtavismLibraries.GeneticAtavismDef>
          <defName>DZ_Atavism_Wooly_To_Dire</defName>
          <sourceXenotype>DZ_WoolyCentaur</sourceXenotype>
          <targetXenotype>DZ_DireCentaur</targetXenotype>
          <chance>0.05</chance>
          <InheritanceMode>excess</InheritanceMode>
          <order>0</order>
        </AtavismLibraries.GeneticAtavismDef>

      </value>
    </match>
  </Operation>

</Patch>
