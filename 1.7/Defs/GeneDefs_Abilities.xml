<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <GeneDef>
    <defName>DZ_Nightmare</defName>
    <label>nightmare</label>
    <description>Carriers can drag a waking nightmare up through a hostile's mind with a stare, sending them fleeing in panic for a short time.</description>
    <iconPath>BSCE/Abilities/Nightmare</iconPath>
    <displayCategory>Ability</displayCategory>
    <prerequisite>Hemogenic</prerequisite>
    <marketValueFactor>1.3</marketValueFactor>
    <abilities>
      <li>DZ_Nightmare</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>DZ_Nightmare</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>0</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>night</symbol></li>
        <li><symbol>dread</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>mare</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef>
    <defName>DZ_UnicornBlessing</defName>
    <label>unicorn blessing</label>
    <description>Carriers can touch an ally with a calming radiance that sharpens the mind and lifts the spirit for a couple of hours.</description>
    <iconPath>BSCE/Abilities/Unicorn</iconPath>
    <displayCategory>Ability</displayCategory>
    <marketValueFactor>1.3</marketValueFactor>
    <abilities>
      <li>DZ_UnicornBlessing</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>DZ_UnicornBlessing</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-1</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>bless</symbol></li>
        <li><symbol>grace</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>touch</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef>
    <defName>DZ_UnicornMending</defName>
    <label>unicorn mending</label>
    <description>Carriers can touch an ally with a restorative radiance that doubles wound healing and immunity gain for six hours.</description>
    <iconPath>BSCE/Abilities/UnicornMend</iconPath>
    <displayCategory>Ability</displayCategory>
    <marketValueFactor>1.3</marketValueFactor>
    <abilities>
      <li>DZ_UnicornMending</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>DZ_UnicornMending</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-1</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>mend</symbol></li>
        <li><symbol>heal</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>horn</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>
